# One address for every agent. The official nginx image substitutes the
# ${...} variables that are set in its environment; nginx's own $variables
# are left alone.
server {
    listen 8080;
    client_max_body_size 64m;

    # node-agent sends its API_KEY in this header.
    if ($http_x_api_key != "${API_KEY}") {
        return 401;
    }

    location = /v1/metrics {
        proxy_set_header Authorization "Basic ${VM_BASIC_AUTH}";
        proxy_pass http://victoriametrics:8428/api/v1/write;
    }
    location = /v1/traces {
        proxy_pass http://otel-collector:4318/v1/traces;
    }
    location = /v1/logs {
        proxy_pass http://otel-collector:4318/v1/logs;
    }
    location / {
        return 404;
    }
}
